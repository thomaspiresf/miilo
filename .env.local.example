# ==========================================================================
#  miilo — variáveis de ambiente
#  Copie para .env.local e preencha. Sem nada preenchido, o app roda em
#  modo demonstração (catálogo de exemplo, frete fixo, pagamento simulado).
# ==========================================================================

# ---------- Supabase ----------
# Painel Supabase -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
# chave "publishable" (sb_publishable_...) — pode aparecer no cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# chave "secret" (sb_secret_...) — NUNCA no cliente, só em route handlers
SUPABASE_SERVICE_ROLE_KEY=

# Token para o endpoint que popula o catálogo de exemplo (POST /api/dev/seed)
SEED_TOKEN=
# E-mails com acesso ao painel /admin (separados por vírgula)
ADMIN_EMAILS=
# Mostra o botão "Continuar com Google" (só após habilitar o provedor no Supabase)
NEXT_PUBLIC_GOOGLE_LOGIN=false
# Libera o /admin sem login (só desenvolvimento — nunca em produção)
ADMIN_DEV_BYPASS=false

# ---------- Mercado Pago ----------
# https://www.mercadopago.com.br/developers/panel/app  -> Credenciais
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Segredo do webhook (Notificações -> Webhooks -> "Assinatura secreta")
MP_WEBHOOK_SECRET=
# true = simula aprovação sem chamar o Mercado Pago
MOCK_PAYMENTS=true

# ---------- Melhor Envio ----------
# melhorenvio.com.br -> Configurações -> Tokens -> permissão "shipping-calculate"
MELHOR_ENVIO_TOKEN=
# false = produção (o cálculo de frete não custa nada; use produção direto)
MELHOR_ENVIO_SANDBOX=false
# CEP de onde os pedidos são despachados (a loja)
STORE_ORIGIN_CEP=01001000
# e-mail de contato exigido pelo Melhor Envio no User-Agent
MELHOR_ENVIO_CONTACT_EMAIL=
# true = ignora o Melhor Envio e usa uma tabela de frete fixa
MOCK_SHIPPING=true

# ---------- Resend (e-mails transacionais) ----------
# resend.com -> API Keys -> Create (permissão "Sending access", domínio miilo.com.br)
# Sem essa chave, os e-mails viram no-op (o app segue normal).
RESEND_API_KEY=
# Remetente — precisa ser de um domínio verificado no Resend
RESEND_FROM=miilo <pedidos@miilo.com.br>

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=miilo
