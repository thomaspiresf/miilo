# ==========================================================================
#  miilo — variáveis de ambiente
#  Copie para .env.local e preencha. Sem nada preenchido, o app roda em
#  modo demonstração (catálogo de exemplo, frete fixo, pagamento simulado).
# ==========================================================================

# ---------- Supabase ----------
# Painel Supabase -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
# chave "publishable" (sb_publishable_...) — pode aparecer no cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# chave "secret" (sb_secret_...) — NUNCA no cliente, só em route handlers
SUPABASE_SERVICE_ROLE_KEY=

# Token para o endpoint que popula o catálogo de exemplo (POST /api/dev/seed)
SEED_TOKEN=
# E-mails com acesso ao painel /admin (separados por vírgula)
ADMIN_EMAILS=
# Admin "master" — além do painel, gerencia usuários e apaga pedidos
ADMIN_MASTER_EMAILS=
# Mostra o botão "Continuar com Google" (só após habilitar o provedor no Supabase)
NEXT_PUBLIC_GOOGLE_LOGIN=false
# Libera o /admin sem login (só desenvolvimento — nunca em produção)
ADMIN_DEV_BYPASS=false

# ---------- Mercado Pago ----------
# https://www.mercadopago.com.br/developers/panel/app  -> Credenciais
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Segredo do webhook (Notificações -> Webhooks -> "Assinatura secreta")
MP_WEBHOOK_SECRET=
# true = simula aprovação sem chamar o Mercado Pago
MOCK_PAYMENTS=true

# ---------- Melhor Envio ----------
# melhorenvio.com.br -> Configurações -> Tokens -> permissão "shipping-calculate"
MELHOR_ENVIO_TOKEN=
# false = produção (o cálculo de frete não custa nada; use produção direto)
MELHOR_ENVIO_SANDBOX=false
# CEP de onde os pedidos são despachados (a loja)
STORE_ORIGIN_CEP=01001000
# e-mail de contato exigido pelo Melhor Envio no User-Agent
MELHOR_ENVIO_CONTACT_EMAIL=
# true = ignora o Melhor Envio e usa uma tabela de frete fixa
MOCK_SHIPPING=true

# ---------- Resend (e-mails transacionais) ----------
# resend.com -> API Keys -> Create (permissão "Sending access", domínio miilo.com.br)
# Sem essa chave, os e-mails viram no-op (o app segue normal).
RESEND_API_KEY=
# Remetente — precisa ser de um domínio verificado no Resend
RESEND_FROM=miilo <pedidos@miilo.com.br>

# ---------- WhatsApp (aviso de venda pro lojista, via Meta Cloud API) ----------
# developers.facebook.com -> criar app -> produto WhatsApp -> API Setup
# Token permanente: Business Settings -> System Users -> gerar token
# (o token temporário que aparece na tela de setup expira em 24h)
WHATSAPP_ACCESS_TOKEN=
# API Setup -> "Phone number ID" (não é o número em si)
WHATSAPP_PHONE_NUMBER_ID=
# Nome do template aprovado na Meta (ex.: nova_venda) — sem isso, no-op
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR
# Números que recebem o aviso, com DDI+DDD (sem símbolos), separados por
# vírgula. Em modo teste da Meta, precisam estar cadastrados como
# destinatários de teste no painel (limite de 5). Também é a lista de quem
# pode COMANDAR o bot (ver abaixo) — só esses números são atendidos.
WHATSAPP_NOTIFY_NUMBERS=

# ---------- Bot de comandos por WhatsApp ("vendi 1 body...") ----------
# App da Meta -> Configurações -> Básico -> "Chave secreta do aplicativo"
# Sem isso, o webhook não aceita NENHUMA mensagem (por segurança).
WHATSAPP_APP_SECRET=
# Uma string qualquer que você escolhe — cole a mesma no cadastro do
# webhook no painel da Meta (WhatsApp -> Configuration -> Webhook).
WHATSAPP_VERIFY_TOKEN=
# console.anthropic.com -> API Keys (conta separada da sua assinatura do
# Claude/Claude Code — cobra por uso, centavos no seu volume). Sem isso, o
# bot não entende a mensagem (sempre responde "não entendi").
ANTHROPIC_API_KEY=

# ---------- Analytics ----------
# analytics.google.com -> Admin -> Fluxo de dados -> ID de métricas (G-XXXXXXX)
# Sem isso, o Google Analytics fica desligado (nada é carregado).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# business.facebook.com/events_manager -> ID do pixel
# Sem isso, o Meta Pixel fica desligado (nada é carregado).
NEXT_PUBLIC_META_PIXEL_ID=
# E-mail mostrado na página /privacidade pra dúvidas sobre dados
NEXT_PUBLIC_PRIVACY_EMAIL=contato@miilo.com.br

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=miilo
# Número do WhatsApp da loja (DDI+DDD+número, só dígitos) — o botão flutuante
# da loja abre a conversa com o bot de atendimento nesse número.
NEXT_PUBLIC_STORE_WHATSAPP=5515991020168
